# MathMind production environment. Copy to .env, set restrictive file permissions, and set this to production.
MATHMIND_ENV=

# Required in production: long unique signing secret (do not use the development default).
JWT_SECRET=

# Required in production: long unique secret for anonymized IP fingerprints.
MATHMIND_IP_HASH_SECRET=

# Required in production: initial administrator password (must not be admin123).
ADMIN_PASS=

# Optional LLM configuration; environment variables take precedence over SQLite settings.
MATHMIND_LLM_API_KEY=
MATHMIND_LLM_PROVIDER=
MATHMIND_LLM_MODEL=
MATHMIND_LLM_BASE_URL=

# Optional public filing information, supplied only when building a regulated deployment.
VITE_ICP_FILING_NUMBER=
VITE_ICP_FILING_URL=
VITE_POLICE_FILING_NUMBER=
VITE_POLICE_FILING_URL=
